<Window x:Class="MatrixUtilsNetFX.MainAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MatrixUtilsNetFX"
        mc:Ignorable="d"
        Title="MatrixUtils" Height="500" Width="800" ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner">
    <Grid>
        <TabControl>
            <TabItem x:Name="tabDeterminant" Header="Determinant">
                <Grid Background="Transparent">
                    <Label Content="Enter matrix dimensions" HorizontalAlignment="Left" Margin="41,6,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="Determinant_txtDimensions" HorizontalAlignment="Left" Margin="194,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="38" TextChanged="Determinant_txtDimensions_TextChanged" MaxLength="1" />
                    <Button x:Name="Determinant_btnGenerateEntryGrid" Content="Generate entry grid" HorizontalAlignment="Left" Margin="41,54,0,0" VerticalAlignment="Top" Click="Determinant_btnGenerateEntryGrid_Click" IsEnabled="False" />
                    <Button x:Name="Determinant_btnFindDeterminant" Content="Find determinant" HorizontalAlignment="Left" Margin="174,54,0,0" VerticalAlignment="Top" Click="Determinant_btnFIndDeterminant_Click" IsEnabled="False" />
                    <Grid x:Name="Determinant_subGridMatrix" Background="LightGray" Margin="10,90,10,10"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabMultiply" Header="Multiply">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="33*"/>
                        <ColumnDefinition Width="761*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Enter matrix dimensions:" HorizontalAlignment="Left" Margin="10,22,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="Multiply_txtRowsA" HorizontalAlignment="Left" Margin="184,28,0,0" VerticalAlignment="Top" Width="30" MaxLength="1" Grid.Column="1" TextChanged="Multiply_txtsDimensions_TextChanged"/>
                    <TextBox x:Name="Multiply_txtColsA" HorizontalAlignment="Left" Margin="241,28,0,0" VerticalAlignment="Top" Width="30" MaxLength="1" Grid.Column="1" TextChanged="Multiply_txtsDimensions_TextChanged"/>
                    <TextBox x:Name="Multiply_txtRowsB" HorizontalAlignment="Left" Margin="184,66,0,0" VerticalAlignment="Top" Width="30" MaxLength="1" Grid.Column="1" TextChanged="Multiply_txtsDimensions_TextChanged"/>
                    <TextBox x:Name="Multiply_txtColsB" HorizontalAlignment="Left" Margin="241,66,0,0" VerticalAlignment="Top" Width="30" MaxLength="1" Grid.Column="1" TextChanged="Multiply_txtsDimensions_TextChanged"/>
                    <Label Content="X" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="219,26,0,0" Grid.Column="1"/>
                    <Label Content="X" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="219,62,0,0" Grid.Column="1"/>
                    <Label Content="Matrix A:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="122,22,0,0" Grid.Column="1"/>
                    <Label Content="Matrix B:" HorizontalAlignment="Left" Margin="122,62,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                    <Button x:Name="Multiply_btnGenerateEntryGrids" Content="Generate entry grids" HorizontalAlignment="Left" Margin="66,103,0,0" VerticalAlignment="Top" Click="Multiply_btnGenerateEntryGrids_Click" Grid.Column="1" IsEnabled="False"/>
                    <Button x:Name="Multiply_btnFindProduct" Content="Find product" HorizontalAlignment="Left" Margin="199,103,0,0" VerticalAlignment="Top" Click="Multiply_btnFindProduct_Click" IsEnabled="False" Grid.Column="1"/>
                    <Button x:Name="Multiply_btnClearAll" Content="Clear all" HorizontalAlignment="Left" Margin="0,103,0,0" VerticalAlignment="Top" Click="Multiply_btnClearAll_Click" Grid.Column="1"/>
                    <Grid x:Name="Multiply_subGridA" Background="LightGray" Margin="0,150,400,0" Grid.ColumnSpan="2"/>
                    <Grid x:Name="Multiply_subGridB" Background="LightGray" Margin="367,150,0,0" Grid.Column="1"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
