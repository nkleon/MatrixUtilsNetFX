<Window x:Class="MatrixMultiplier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MatrixMultiplier"
        mc:Ignorable="d"
        Title="Matrix Multiplier" Height="500" Width="800" ResizeMode="CanMinimize">
    <Grid>
        <Label Content="Enter matrix dimensions" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtRowsA" HorizontalAlignment="Left" Margin="36,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100"/>
        <TextBox x:Name="txtColsA" HorizontalAlignment="Left" Margin="190,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100"/>
        <TextBox x:Name="txtRowsB" HorizontalAlignment="Left" Margin="460,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100"/>
        <TextBox x:Name="txtColsB" HorizontalAlignment="Left" Margin="614,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100"/>
        <Label Content="X" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="155,67,0,0"/>
        <Label Content="X" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="577,67,0,0"/>
        <Label Content="Matrix A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="136,40,0,0"/>
        <Label Content="Matrix B" HorizontalAlignment="Left" Margin="559,40,0,0" VerticalAlignment="Top"/>
        <Button Content="Generate entry grid" HorizontalAlignment="Left" Margin="278,103,0,0" VerticalAlignment="Top" Click="Button_Click" />
        <Button Content="Calculate product" HorizontalAlignment="Left" Margin="418,103,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>
        <Grid x:Name="subGridA" Background="LightGray" Margin="0,150,400,0"/>
        <Grid x:Name="subGridB" Background="LightGray" Margin="400,150,0,0"/>
    </Grid>
</Window>
