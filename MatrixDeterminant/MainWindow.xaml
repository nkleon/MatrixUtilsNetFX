<Window x:Class="MatrixDeterminant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MatrixDeterminant"
        mc:Ignorable="d"
        Title="Matrix Determinant" Height="500" Width="800" ResizeMode="CanMinimize">
    <Grid Margin="0,10,0,0">
        <Label Content="Enter matrix dimensions" HorizontalAlignment="Left" Margin="41,6,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtDimensions" HorizontalAlignment="Left" Margin="194,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="100" TextChanged="txtDimensions_TextChanged"/>
        <Button x:Name="btnGenerateGrid" Content="Generate entry grid" HorizontalAlignment="Left" Margin="41,54,0,0" VerticalAlignment="Top" Click="btnGenerateGrid_Click" IsEnabled="False" />
        <Button x:Name="btnGetDeterminant" Content="Get determinant" HorizontalAlignment="Left" Margin="174,54,0,0" VerticalAlignment="Top" Click="btnGetDeterminant_Click" IsEnabled="False" />
        <Grid x:Name="subGrid" Background="LightGray" Margin="10,90,10,10"/>
    </Grid>
</Window>
